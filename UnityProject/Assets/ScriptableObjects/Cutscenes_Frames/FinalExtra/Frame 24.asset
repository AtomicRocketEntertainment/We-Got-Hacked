  Sprite: {fileID: 21300000, guid: 9bb2e61c355b1be469bb04762d406fb2, type: 3}
  TextStatus:
    Text: "Ap\xF3s os acontecimentos na PetroCais, criou um forte la\xE7o paterno
      com Larisso. Percebeu que, de vez em quando, \xE9 bom realmente conversar com
      algu\xE9m sobre assuntos que n\xE3o envolvam ciberseguran\xE7a, pol\xEDtica
      ou as atitudes de jogadores milion\xE1rios. Apesar de ainda ter dificuldade
      para falar sobre problemas pessoais e sentimentos, est\xE1 tentando melhorar
      nisso."
  IsEndFrame: 0
