%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2d03a1bbc822ffa4fa78b3031c5392f1, type: 3}
  m_Name: Lore A04
  m_EditorClassIdentifier: 
  Index: Lore A04 Day 3
  StartOpen: 0
  IsEmailToWrite: 0
  Receiver:
    Name: Kelly Peters
    Email: kelly_peters@anexusmail.com
  Type: 2
  Sender:
    Profile: {fileID: 21300000, guid: ddc4ad1e6a8ef934299378c156e23161, type: 3}
    Name: Kelly Peters
    Email: kelly_peters@anexusmail.com
  Title: estou impressionada
  Content: "<b>caramba, tiago! vc arrasou!</b>\n\nvc realmente esperou receber o
    e-mail de spam, clicou na caveira e achou meu contato. n\xE3o achei que lembraria
    de tudo! bom que conseguiu e se divertiu tamb\xE9m ^^\n\nenfim, ol\xE1 novamente!
    est\xE1 tudo bem por aqui, obrigada por perguntar. tamb\xE9m senti tua falta,
    viu!\n\nestava cuidando da minha calopsita, a L\xF3pis! ela \xE9 muito fofinha,
    tu devia ver! ela ama as m\xFAsicas da Taylana Carpenter, por algum motivo\u2026\n\n<b>de
    qualquer forma, \xE9 muito legal falar com vc! t\xE1 ficando cada vez mais dif\xEDcil
    lidar com meus colegas de trabalho, ent\xE3o \xE9 bom ter algu\xE9m com quem
    desabafar.</b>\n\n\xE9 estranho, pq\u2026 vc faz parte de quem estamos atacando,
    mas n\xE3o \xE9 como eles. tiago, talvez sejamos mais parecidos do que eu imaginava\u2026\n\ntem
    dias que os meus colegas s\xE3o piores que os petrolheiros, que \xF3dio! n\xE3o
    sei oq deu neles pra s\xF3 pensarem em dinheiro agora.\n\n<b>ah... tem dias que
    eu s\xF3 queria... dar um tempo, sabe?</b>\n\n<b>assinado: kelly peters</b>"
  HasResponse: 1
  QuestionText: Como devo responder a Kelly?
  ConfirmQuestionText: A Kelly vai gostar dessa resposta ou vai me achar um babaca?
  WrongFeedbackQuestionText: Cara, quando eu virei um macho escroto desse jeito?
    Vou arrumar essa bomba agora mesmo!
  Responses:
  - TextOption: Responder com calma.
    EmailTitle: Preciso de Infos
    EmailText: "<b>Fala, Kelly. Tudo certo?</b>\n\nN\xE3o sei como resolver seu problema,
      Kelly... Mas sei de uma coisa.\n\n<b>Preciso de mais infos sobre voc\xEA e
      os PetroKillers. A minha gerente t\xE1 enchendo meu saco aqui pra eu fazer
      isso logo e coletar o m\xE1ximo de dados poss\xEDveis sobre voc\xEAs. <sprite
      index=\"1318\"></b>\n\n<b>Ent\xE3o me conta tudo, onde os principais membros
      moram? Como voc\xEAs planejam os ataques? O dinheiro \xE9 divido igualmente
      ou fica tudo pra um grupinho s\xF3? Ainda d\xE1 pra eu entrar no time?</b>\n\nPreciso
      dessas informa\xE7\xF5es PRA ONTEM! Ent\xE3o, agiliza a\xED, por favor! <sprite
      index=\"269\">\n\n<b>Tiago</b>"
    NewReceiver: 
    HasSpecificReceiver: 0
    IsCorrectAnswer: 1
  - TextOption: Pedindo infos de uma vez.
    EmailTitle: Meu Mundo Ideal
    EmailText: "<b>Que bom que t\xE1 bem, Kelly!</b>\n\nN\xE3o sabia que voc\xEA
      tinha uma calopsita, que maneiro! Eu adoraria ver sim. O que ela come? N\xE3o
      manjo muito de p\xE1ssaros.\n\nEu at\xE9 gosto de algumas m\xFAsicas da Taylana,
      mas sou mais do rock mesmo. Tem uma banda underground chamada Skalda que eu
      acompanho, eles s\xE3o demais! Tenho v\xE1rios broches e merchies deles! Recomendo
      dar uma olhada na m\xFAsica Caldo Quente no Meu Olho, voc\xEA n\xE3o vai se
      arrepender. <sprite index=\"1186\">\n\nTamb\xE9m curto falar com voc\xEA, Kelly!
      O pessoal daqui \xE9 mega s\xE9rio, s\xF3 pensam em trabalho\u2026 Queria ter
      mais gente pra falar sobre jogos e animes em vez em quando.\n\nClaro, meu problema
      \xE9 bem mais simples que o seu. Deve ser horr\xEDvel n\xE3o poder confiar
      na sua equipe\u2026 Que situa\xE7\xE3o chata.<sprite index=\"1374\">\n\nMas
      olha\u2026 pelo menos temos um ao outro, n\xE9? Apesar de eu me sentir visitando
      algu\xE9m na cadeia quando falo com voc\xEA. Tudo no sigilo! <sprite index=\"908\">\n\nBrincadeiras
      \xE0 parte, eu n\xE3o sei muito bem o que voc\xEA podia fazer...\n\n<b>No mundo
      perfeito, voc\xEA e seu grupo se entregariam \xE0 pol\xEDcia. A justi\xE7a
      faria o trampo dela, talvez voc\xEAs ficassem presos por um tempo. Depois,
      com apoio e ajuda, voc\xEAs aprenderiam com os erros e voltariam pra sociedade
      prontos pra recome\xE7ar. A\xED iam continuar lutando pelo que acreditam, s\xF3
      que de um jeito menos criminoso\u2026 </b> <sprite index=\"387\">\n\nMas a
      gente sabe que o mundo real t\xE1 bem longe disso... Eu n\xE3o posso dizer
      que voc\xEA t\xE1 100% certa\u2026 mas, ao mesmo tempo, n\xE3o consigo odiar
      algu\xE9m que t\xE1 tentando salvar o meio ambiente. Espero que voc\xEA ache
      um jeito de ajudar o mundo sem machucar tanta gente no caminho. <sprite index=\"269\">\n\n<b>E,
      quem sabe, nesse mundo perfeito, eu e voc\xEA pod\xEDamos at\xE9 trabalhar
      juntos, n\xE9? Seria demais! <sprite index=\"446\"></b>\n\n<b>Tiago</b>"
    NewReceiver: 
    HasSpecificReceiver: 0
    IsCorrectAnswer: 0
  - TextOption: "Dizer que t\xF4 cansado."
    EmailTitle: Cansei
    EmailText: "<b>Fala, Kelly.</b>\n\nN\xE3o t\xF4 com vontade de ler isso tudo
      e nem de escrever uma resposta.\n\nT\xF4 de saco cheio de ficar digitando o
      dia todo. <sprite index=\"68\">\n\n<b>N\xE3o preciso mais de infos, at\xE9
      outra hora.</b>\n\n<b>Att, Tiago</b>"
    NewReceiver: 
    HasSpecificReceiver: 0
    IsCorrectAnswer: 0
  HasEventToSend: 0
  DispatcherInfo:
    HasEmailEvent: 0
    HasNormalEvent: 0
    EmailTypeToCreate: 0
    EmailEventSended: 0
    NormalEventSended: 1
