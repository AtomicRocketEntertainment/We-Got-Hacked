MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2d03a1bbc822ffa4fa78b3031c5392f1, type: 3}
  m_Name: Lore 16
  m_EditorClassIdentifier: 
  Index: Lore 16 Day 2
  StartOpen: 0
  IsEmailToWrite: 1
  Receiver:
    Name: 'Raquel Garcia Hent '
    Email: raquel.g.hent@cafesoc.com
  Type: 2
  Sender:
    Profile: {fileID: 21300000, guid: 9954022b95caf504b97bf84c996f1685, type: 3}
    Name: Rafael Medina Oliveira
    Email: rafael.medi.o@cafesoc.com
  Title: 
  Content: "<b>Tiago,</b>\n\nPrimeiramente, lhe desejo uma boa noite. Espero que
    esteja tudo nos conformes.\n\nA partir desse momento, passaremos a utilizar um
    recurso do SIEMtinel que n\xE3o foi explorado anteriormente. O campo de Log e
    HASH.\n\nAcesse o software e verifique um novo alerta que est\xE1 intencionalmente
    marcado como falso positivo. Este alerta tem fins exclusivamente did\xE1ticos,
    portanto, nenhuma a\xE7\xE3o pr\xE1tica \xE9 necess\xE1ria neste momento.\n\n<b>Ao
    abri-lo, direcione sua aten\xE7\xE3o \xE0 se\xE7\xE3o inferior, onde est\xE1
    localizado o campo HASH. Trata-se de uma assinatura digital \xFAnica associada
    a arquivos execut\xE1veis, que pode ser extremamente \xFAtil na identifica\xE7\xE3o
    de padr\xF5es recorrentes e elementos potencialmente maliciosos.</b>\n\n<b>Al\xE9m
    disso, confira o bot\xE3o de Log dispon\xEDvel no alerta em quest\xE3o. Voc\xEA
    notar\xE1 que alguns arquivos presentes nos registros exibem a extens\xE3o \u201C.locked\u201D.
    Essa nomenclatura \xE9 um indicativo recorrente em ataques de ransomware, sugerindo
    que os arquivos foram criptografados.</b>\n\nO objetivo desta orienta\xE7\xE3o
    \xE9 ampliar sua familiaridade com sinais de comportamento malicioso, mesmo que
    nem sempre eles estejam vis\xEDveis na superf\xEDcie.\n\nMantenha o foco.\n\n<b>Raquel
    Oliveira</b>\nGerente de Cyberseguran\xE7a \u2013 C.A.F.E."
  HasResponse: 1
  QuestionText: "Hmm... Quais novidades eu tenho em m\xE3os para contar?"
  ConfirmQuestionText: "\xC9 realmente isso que quero falar pra mestre da ciber seguran\xE7a?"
  WrongFeedbackQuestionText: "Maldi\xE7\xE3o, isso t\xE1 errado! O tempo \xE9 um
    artefato raro, e n\xE3o posso me dar ao luxo de desperdi\xE7\xE1-lo mais uma
    vez."
  Responses:
  - TextOption: Temos Novas?
    EmailTitle: Algo Importante?
    EmailText: "<b>Ol\xE1, Mestre,</b>\n\nVim contar que conseguimos algo importante
      hoje!\n\n<b>S\xF3 um momento... o que era mesmo? Minha mente parece envolta
      em n\xE9voa, como se algum inimigo tivesse lan\xE7ado um ataque ps\xEDquico
      de n\xEDvel alto...</b>\L\nPe\xE7o perd\xE3o por ter gasto seu precioso tempo,
      Mestre. Caso consiga recordar, mando mensagem de novo.\n\n<b>Atenciosamente,</b>\n<b>Rafael
      Medi. Oliveira</b>"
    NewReceiver: 
    HasSpecificReceiver: 0
    IsCorrectAnswer: 0
  - TextOption: "Nem t\xE3o boas novas..."
    EmailTitle: "Ainda n\xE3o descobrimos..."
    EmailText: "<b>Ol\xE1, Mestre,</b>\n\n<b>Ainda n\xE3o descobrimos o IP de origem
      que os inimigos usaram para nos atacar... Mas encontraremos em breve! N\xE3o
      irei descansar enquanto essa maldi\xE7\xE3o virtual n\xE3o for bloqueada!</b>\n\nAvante!\n\n<b>Atenciosamente,</b>\n<b>Rafael
      Medi. Oliveira</b>"
    NewReceiver: 
    HasSpecificReceiver: 0
    IsCorrectAnswer: 0
  - TextOption: Boas novas!
    EmailTitle: Boas Novas!
    EmailText: "<b>Ol\xE1, Mestre,</b>\n\nBoas novas!\n\n<b>J\xE1 descobrimos o IP
      de origem que os inimigos usaram para atacar a fortaleza. Ele ser\xE1 bloqueado
      de imediato para que novas conex\xF5es desse destino n\xE3o nos incomodem novamente.</b>\n\nAvante!\n\n<b>Atenciosamente,</b>\n<b>Rafael
      Medi. Oliveira</b>"
    NewReceiver: 
    HasSpecificReceiver: 0
    IsCorrectAnswer: 1
  HasEventToSend: 0
  DispatcherInfo:
    HasEmailEvent: 0
    HasNormalEvent: 0
    EmailTypeToCreate: 0
    EmailEventSended: 0
    NormalEventSended: 0
