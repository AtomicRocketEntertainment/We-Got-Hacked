%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12fbd196871e4794299cfa0f154a6174, type: 3}
  m_Name: "Thayn\xE1 Portalupi Avoss"
  m_EditorClassIdentifier: 
  Name: "Thayn\xE1 Portalupi Avoss"
  IdleStreaming: {fileID: 21300000, guid: a50f2a8fc03bdb3409ebea8f7a802e5b, type: 3}
  IdleAwaiting: {fileID: 21300000, guid: 4151514e63f9cf74aad1673e10cee7ed, type: 3}
  Talking: {fileID: 0}
  Lines:
    Lines:
    - Text: "\"Minha nossa... Isso \xE9 terr\xEDvel!\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Eu adoro suco de laranja! Por\xE9m, o mais importante \xE9 aguardar
        a retirada do site pelo provedor. Tomara que nenhuma outra empresa seja prejudicada
        enquanto isso n\xE3o acontece.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Perdoe-me, mas nossa responsabilidade vai al\xE9m dos interesses da
        empresa, e n\xE3o podemos desconsiderar o impacto que isso gera em todo o
        setor. O mundo n\xE3o gira apenas em torno da PetroCais. \""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Senhorita Raquel, haveria alguma forma de promover a conscientiza\xE7\xE3o
        dos funcion\xE1rios em rela\xE7\xE3o \xE0 ciberseguran\xE7a? N\xE3o seria
        legal ver incidentes assim acontecerem de novo...\""
      IsLineToAnswer: 1
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Parece mesmo inovador! Como usar\xEDamos esses jogos?\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Voltando ao incidente... Assim como no dia anterior, estou montando
        um comunicado sobre as atualiza\xE7\xF5es do caso para enviar \xE0 m\xEDdia.
        Algum outro conselho, senhorita Raquel?\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"\xD3timo! Muito obrigada!\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"At\xE9 logo, pessoal! Uma \xF3tima semana para voc\xEAs!\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
