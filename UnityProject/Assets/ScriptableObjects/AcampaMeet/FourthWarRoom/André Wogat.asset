  Name: "Andr\xE9 Wogat"
  IdleStreaming: {fileID: 21300000, guid: 9329bbf6514d7934b86f74ef4492ee6a, type: 3}
  IdleAwaiting: {fileID: 21300000, guid: 93711244522340f4491987d7eb6481b1, type: 3}
  Talking: {fileID: 0}
  Lines:
    Lines:
    - Text: "\"N\xE3o acredito que isso resolva o problema. Espero que a pol\xEDcia
        fa\xE7a seu trabalho e que os respons\xE1veis mofem na cadeia.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"O nosso n\xE3o estando na reta, j\xE1 est\xE1 de bom tamanho.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"N\xF3s que fazemos o mundo girar, mocinha.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
