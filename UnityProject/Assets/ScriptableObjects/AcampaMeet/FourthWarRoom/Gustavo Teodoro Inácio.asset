  m_Script: {fileID: 11500000, guid: 12fbd196871e4794299cfa0f154a6174, type: 3}
  m_Name: "Gustavo Teodoro In\xE1cio"
  m_EditorClassIdentifier: 
  Name: "Gustavo Teodoro In\xE1cio"
  IdleStreaming: {fileID: 21300000, guid: f200137e42fd48e44b02cbffa38ff92f, type: 3}
  IdleAwaiting: {fileID: 21300000, guid: bd0bb96160815a84c8150ce9b30d0f2f, type: 3}
  Talking: {fileID: 0}
  Lines:
    Lines:
    - Text: "\"Boa! O Eduardo me mandou a corre\xE7\xE3o aqui. J\xE1 t\xE1 sendo
        aplicada.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: '"Falando no homi..."'
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Ei, Raquel. Ser\xE1 que tem chance deles nos atacarem de novo? Porque
        eu j\xE1 t\xF4 por aqui com esses caras!\""
      IsLineToAnswer: 1
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"N\xE3o conhe\xE7o tanto dessa \xE1rea, mas d\xE1 pra usar como incentivo
        pros funcion\xE1rios mais jovens. Eles j\xE1 vivem socados em joguinhos de
        celular no meio do hor\xE1rio de servi\xE7o mesmo.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"J\xE1 vi um que simulava o dia-a-dia de um SOC. Parecia interessante.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Minhas costas foram pro saco j\xE1... Por\_hoje\_deu!\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
