  Name: "Gustavo Teodoro In\xE1cio"
  IdleStreaming: {fileID: 21300000, guid: df3b4e3e1b4c87d4eae6e231ab840d07, type: 3}
  IdleAwaiting: {fileID: 21300000, guid: bd0bb96160815a84c8150ce9b30d0f2f, type: 3}
  Talking: {fileID: 0}
  Lines:
    Lines:
    - Text: "\"Desgra\xE7ados! Eu n\xE3o sei como eles conseguiram entrar! Temos
        uma aplica\xE7\xE3o de seguran\xE7a muito foda! N\xE3o acredito que conseguiram
        vazar os dados...\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Esses caras querem acabar com a gente... Voc\xEAs j\xE1 sabem a origem
        do vazamento? V\xE3o come\xE7ar a investiga\xE7\xE3o por onde?\""
      IsLineToAnswer: 1
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
