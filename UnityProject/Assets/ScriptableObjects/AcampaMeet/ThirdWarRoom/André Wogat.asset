  Name: "Andr\xE9 Wogat"
  Idle: {fileID: 21300000, guid: 5b2a06d82861d7a48a992f2e581b08e0, type: 3}
  Talking: {fileID: 0}
  Lines:
    Lines:
    - Text: "\"Isso n\xE3o responde como entramos na resid\xEAncia desses marginais
        que se escondem por tr\xE1s da tela e jogarmos eles na cadeia.\""
      IsLineToAnswer: 1
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Entendi... Ent\xE3o o trabalho sujo fica pra pol\xEDcia...\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Perdemos milh\xF5es de reais por causa desses desempregados escrotos!
        Eles s\xE3o criminosos, n\xE3o me venha com essa de boa samaritana.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
