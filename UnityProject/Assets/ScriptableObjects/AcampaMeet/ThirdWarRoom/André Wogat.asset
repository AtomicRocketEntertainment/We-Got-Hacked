  Name: "Andr\xE9 Wogat"
  IdleStreaming: {fileID: 21300000, guid: 9329bbf6514d7934b86f74ef4492ee6a, type: 3}
  IdleAwaiting: {fileID: 21300000, guid: 93711244522340f4491987d7eb6481b1, type: 3}
  Talking: {fileID: 0}
  Lines:
    Lines:
    - Text: "\"Isso n\xE3o responde como entramos na resid\xEAncia desses marginais
        que se escondem por tr\xE1s da tela e jogamos eles na cadeia.\""
      IsLineToAnswer: 1
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Entendi... Ent\xE3o o trabalho sujo fica para a pol\xEDcia...\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Perdemos milh\xF5es de reais por causa desses escrotos! Eles s\xE3o
        criminosos, n\xE3o me venha com essa de boa samaritana.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
