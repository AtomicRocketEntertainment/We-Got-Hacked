  Name: Eduardo Pontes Rodrigues
  IdleStreaming: {fileID: 21300000, guid: 249fab4c9f95b18498dc840cabd1042d, type: 3}
  IdleAwaiting: {fileID: 21300000, guid: a3a82d593a2d3e34c8402091e3cbc3c0, type: 3}
  Talking: {fileID: 0}
  Lines:
    Lines:
    - Text: '"..."'
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Al\xF4? Conseguem me ouvir?\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Bah, nunca me acostumo com isso... Eu disse que mesmo com inspe\xE7\xE3o
        robusta, ainda d\xE1 pra exfiltrar os arquivos.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Basta uma vulnerabilidade e j\xE1 tomamos.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Capaz, eu respondo, mas n\xE3o tenho muito o que acrescentar.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"N\xE3o sei em que servidor o arquivo exfiltrado t\xE1, nem seu endere\xE7o
        de rede. Da\xED t\xF4 meio que largado as tra\xE7as. \""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"J\xF3ia.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
