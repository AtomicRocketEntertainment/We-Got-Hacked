  m_Name: Eduardo Pontes Rodrigues
  m_EditorClassIdentifier: 
  Name: Eduardo Pontes Rodrigues
  IdleStreaming: {fileID: 21300000, guid: 249fab4c9f95b18498dc840cabd1042d, type: 3}
  IdleAwaiting: {fileID: 21300000, guid: a3a82d593a2d3e34c8402091e3cbc3c0, type: 3}
  Talking: {fileID: 0}
  Lines:
    Lines:
    - Text: '"..."'
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Al\xF4? Conseguem me ouvir?\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Bah, nunca me acostumo com isso... Eu disse que mesmo com inspe\xE7\xE3o
        robusta, ainda d\xE1 pra exfiltrar os arquivos.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Basta uma vulnerabilidade e j\xE1 tomamos.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Capaz, eu respondo, sem problemas. O Servidor de Controle de Produ\xE7\xE3o
        n\xE3o mandou a folha de pagamento pra fora, s\xF3 transferiu pro de Log\xEDstica.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Dentro dele tinha uma cacetada de requisi\xE7\xF5es DNS estranhas.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Tenho os dados que foram exfiltrados e os registros de transfer\xEAncia
        at\xE9 o alvo.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"D\xE1 de mostrar os logs do DNS e o IP. E, se quiser, a pessoa que
        mandou o endere\xE7o tamb\xE9m.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"J\xF3ia.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
