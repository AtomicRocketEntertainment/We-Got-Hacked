  m_Script: {fileID: 11500000, guid: 12fbd196871e4794299cfa0f154a6174, type: 3}
  m_Name: "Thayn\xE1 Portalupi Avoss"
  m_EditorClassIdentifier: 
  Name: "Thayn\xE1 Portalupi Avoss"
  IdleStreaming: {fileID: 21300000, guid: a50f2a8fc03bdb3409ebea8f7a802e5b, type: 3}
  IdleAwaiting: {fileID: 21300000, guid: 4151514e63f9cf74aad1673e10cee7ed, type: 3}
  Talking: {fileID: 0}
  Lines:
    Lines:
    - Text: "\"Ahn... Senhor Eduardo... Acho que o senhor est\xE1 mutado. Tente clicar
        no \xEDcone do microfone no canto inferior da tela.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: '"Sim, perfeitamente!"'
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"A pris\xE3o desse grupo hacktivista \xE9 mesmo necess\xE1ria?\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Eu s\xF3 acho que... talvez eles ainda possam entender que mesmo com
        as inten\xE7\xF5es corretas, o que fazem ainda \xE9 extremamente errado e...\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Pe\xE7o perd\xE3o pelos assuntos n\xE3o relacionados, Senhorita Raquel...
        Gostaria de informar que j\xE1 estou entrando em contato com o portal de
        not\xEDcias para colaborar com as informa\xE7\xF5es.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Existe pontos espec\xEDficos que voc\xEA acha coerente acrescentar
        sobre o caso? Ou alguns que seriam melhor evitar?\""
      IsLineToAnswer: 1
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
