  Name: Rafael Medina Oliveira
  Idle: {fileID: 21300000, guid: 89a5eea2cea0a2547912c4fd4f0e14a3, type: 3}
  Talking: {fileID: 0}
  Lines:
    Lines:
    - Text: "\"Ol\xE1, tropa! Rafael \xE0s ordens! O que foi que eu perdi?\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Isso mesmo, lorde das tecnologias. Algumas filiais da Maravi j\xE1
        foram atacadas usando esse ransom como base. \xC9 um dos motivos do nome
        dele ser inspirado no cristal que faz a Mulher Maravi ficar fraca nos quadrinhos.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"At\xE9 mais!\u201D"
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
