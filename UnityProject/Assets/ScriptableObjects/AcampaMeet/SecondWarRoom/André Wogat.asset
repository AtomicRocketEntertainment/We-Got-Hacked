  m_Name: "Andr\xE9 Wogat"
  m_EditorClassIdentifier: 
  Name: "Andr\xE9 Wogat"
  IdleStreaming: {fileID: 21300000, guid: 9329bbf6514d7934b86f74ef4492ee6a, type: 3}
  IdleAwaiting: {fileID: 21300000, guid: 93711244522340f4491987d7eb6481b1, type: 3}
  Talking: {fileID: 0}
  Lines:
    Lines:
    - Text: "\"Eu n\xE3o tenho nada contra essa minoria em quest\xE3o, por\xE9m...\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Muito bem. Ent\xE3o o crime est\xE1 confirmado, o vetor identificado,
        o preju\xEDzo contabilizado... Agora s\xF3 falta responsabilizar algu\xE9m.
        Espero que esse funcion\xE1rio da log\xEDstica que n\xE3o foi nas aulas de
        ciberseguran\xE7a encontre uma caixa de papel\xE3o confort\xE1vel quando
        tiver que dormir na rua.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Precisarei me retirar de imediato, at\xE9 uma pr\xF3xima oportunidade.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
