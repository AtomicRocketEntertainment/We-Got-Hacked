  Talking: {fileID: 0}
  Lines:
    Lines:
    - Text: "\"S\xF3 pra trazer conhecimento pra voc\xEAs, o ransomware usado por
        esses caras foi o Cryptonizer. Ele foi criado pra atacar sistemas de empresas
        de entretenimento, como quadrinhos e cinema, mas pelo visto serve pra outras
        coisas tamb\xE9m.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: '"Boa! Mais uma pra conta! Quem que vai bancar a gelada hoje?"'
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
