  Talking: {fileID: 0}
  Lines:
    Lines:
    - Text: "\"Achei que um guardi\xE3o da lei saberia responder isso...\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Uai? Mas voc\xEAs n\xE3o s\xE3o, tipo... os magos da diplomacia? Di\xE1logo
        n\xE3o \xE9 o que mais usam nas batalhas jur\xEDdicas?\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Santos c\xE9us! Uma luva personalizada! Posso ver?\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Podem contar comigo! Estou preparado para essa miss\xE3o!\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
