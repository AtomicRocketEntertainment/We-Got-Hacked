  Name: Rafael Medina Oliveira
  IdleStreaming: {fileID: 21300000, guid: defc1c456a2dbbf42a63fd71b67d2d2c, type: 3}
  IdleAwaiting: {fileID: 21300000, guid: e165157512a507f468c15a5c44792c5a, type: 3}
  Talking: {fileID: 0}
  Lines:
    Lines:
    - Text: "\"Achei que os advogados saberiam mais sobre quest\xF5es legais do que
        uma gerente de ciber...\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Uai? Mas voc\xEAs n\xE3o s\xE3o tipo... magos da diplomacia durante
        um julgamento? Usando s\xF3 argumentos e palavras dif\xEDceis?\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: '"Que massa! Uma luva personalizada! Posso ver?"'
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: '"Podem contar comigo! Estou pronto para acabar com os planos do inimigo."'
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
