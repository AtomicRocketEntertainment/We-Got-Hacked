%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12fbd196871e4794299cfa0f154a6174, type: 3}
  m_Name: "Andr\xE9 Wogat"
  m_EditorClassIdentifier: 
  Name: "Andr\xE9 Wogat"
  Idle: {fileID: 21300000, guid: 5b2a06d82861d7a48a992f2e581b08e0, type: 3}
  Talking: {fileID: 0}
  Lines:
    Lines:
    - Text: "\"Diante da exig\xEAncia feita, voc\xEA realmente considera qualquer
        forma de negocia\xE7\xE3o com esses criminosos?\""
      IsLineToAnswer: 1
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Voc\xEA n\xE3o sabe nada sobre mim, garoto. N\xE3o me force a recorrer
        ao... 'Di\xE1logo'.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"N\xE3o quis dizer de forma literal. \xC9 que, na \xE9poca em que eu
        lutava boxe, meu par de luvas tinha letras costuradas que formavam a palavra
        'Di\xE1logo' quando eu juntava as m\xE3os... longa hist\xF3ria.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"J\xE1 li sobre esse grupo em algumas reportagens. Aposto que tem muito
        jovem mimado batendo palma para esses discursos ambientais. Querem lutar
        com as empresas que movem a economia do pa\xEDs! \xC9 f\xE1cil pra quem nunca
        trabalhou de verdade na vida. Se dependesse de mim, todos j\xE1 estariam
        processados e sob cust\xF3dia.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Ah, claro... j\xE1 conhe\xE7o seu tipinho...\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"\xC9 prefer\xEDvel que a pr\xF3pria PetroCais conduza a narrativa
        em seus canais oficiais, antes que esses rep\xF3rteres sensacionalistas da
        internet distor\xE7am os fatos como bem entendem.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
