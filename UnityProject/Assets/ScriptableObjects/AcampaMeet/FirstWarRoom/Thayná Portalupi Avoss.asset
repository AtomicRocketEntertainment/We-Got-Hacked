MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12fbd196871e4794299cfa0f154a6174, type: 3}
  m_Name: "Thayn\xE1 Portalupi Avoss"
  m_EditorClassIdentifier: 
  Name: "Thayn\xE1 Portalupi Avoss"
  IdleStreaming: {fileID: 21300000, guid: a50f2a8fc03bdb3409ebea8f7a802e5b, type: 3}
  IdleAwaiting: {fileID: 21300000, guid: 4151514e63f9cf74aad1673e10cee7ed, type: 3}
  Talking: {fileID: 0}
  Lines:
    Lines:
    - Text: "\"Com licen\xE7a, Raquel. Gostaria de fazer uma pergunta, se for um
        bom momento.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\u201CCom base no que sabemos at\xE9 agora, poderia dizer o que sabemos
        sobre o grupo que fez o ataque, por favor?\""
      IsLineToAnswer: 1
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Sou totalmente contr\xE1ria ao ativismo que recorre a m\xE9todos como
        chantagem, invas\xE3o digital, difama\xE7\xE3o e vandalismo...\nNo entanto,
        n\xE3o d\xE1 pra ignorar que as mudan\xE7as clim\xE1ticas est\xE3o afetando
        o mundo inteiro. Inclusive, j\xE1 conversei com o senhor Enzo Kaiser, nosso
        CEO, sobre a necessidade de expandirmos nossos projetos de sustentabilidade,
        mesmo reconhecendo os esfor\xE7os que a PetroCais j\xE1 vem realizando.\""
      IsLineToAnswer: 0
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
    - Text: "\"Pe\xE7o desculpas pelas conversas paralelas. Voltando ao problema,
        a C.A.F.E. sugere que fa\xE7amos uma divulga\xE7\xE3o p\xFAblica sobre o
        incidente?\""
      IsLineToAnswer: 1
      ShouldUpdateStream: 0
      IlustrationToShow: {fileID: 0}
