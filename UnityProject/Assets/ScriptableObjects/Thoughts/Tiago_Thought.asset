  m_Script: {fileID: 11500000, guid: 2083455001a727c46b785bde22a676fd, type: 3}
  m_Name: Tiago_Thought
  m_EditorClassIdentifier: 
  Character: 0
  thoughts:
  - key: 0
    thought: "Por enquanto, t\xF4 sem nada pra escrever. Mas logo logo vai sair algo!"
  - key: 3
    thought: "Tentando ver infos do ticket sem ticket... T\xE1 maluco, o cara \xE9
      muito brabo."
  - key: 1
    thought: "Por que eu t\xF4 tentando mandar ticket sem ticket? Tomei meus rem\xE9dios
      hoje?"
  - key: 2
    thought: "T\xE1 faltando algumas infos aqui, que vacilo..."
  - key: 4
    thought: "A Raquel disse que preciso focar nos alerta vermelhos, burr\xE3o! N\xE3o
      deveria ter s\xF3 passado o olho no e-mail dela\u2026"
  - key: 9
    thought: "Tem algo de errado nesse IP que eu selecionei... N\xE3o sei o que pode
      ser... Talvez todos os n\xFAmeros?"
  - key: 10
    thought: "Eita... Ent\xE3o foi isso que rolou... Ser\xE1 que se eu entrar em
      contato, consigo saber mais sobre eles? T\xF4 muito curioso! Mas tem que ser
      na maciota pra n\xE3o sobrar pra mim..."
  - key: 14
    thought: "Cacetada! Esses hackers n\xE3o t\xE3o de brincadeira... Ser\xE1 que
      isso tudo \xE9 verdade mesmo?"
  - key: 15
    thought: "Funcionou! Que daora! Eu sou mesmo um mestre nos puzzles, h\xE1! Enfim...
      acho melhor avisar a gerente sobre isso. J\xE1 t\xF4 animado pra falar com
      a Kelly de novo!"
