%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2083455001a727c46b785bde22a676fd, type: 3}
  m_Name: Rafael_Thought
  m_EditorClassIdentifier: 
  Character: 1
  thoughts:
  - key: 0
    thought: "\"N\xE3o preciso mandar uma mensagem por agora, ainda estou mapeando
      o terreno.\""
  - key: 3
    thought: "\"Ainda n\xE3o existe uma trilha a seguir. Toda miss\xE3o come\xE7a
      com um chamado.\""
  - key: 1
    thought: "\u201CSe acalme, Rafael... Antes de marchar para a batalha, \xE9 preciso
      forjar sua armadura... Nesse caso, o ticket.\""
  - key: 2
    thought: "\"O chamado foi feito, mas a mensagem ainda est\xE1 incompleta. Precisamos
      de mais dados do inimigo.\""
  - key: 5
    thought: "\"Esse n\xE3o foi o alvo dos ataques... \xC9 como se eu estivesse colocando
      um curativo em um bra\xE7o saud\xE1vel.\""
  - key: 6
    thought: "\"Quando dizem que a pressa \xE9 inimiga da perfei\xE7\xE3o, nem sempre
      \xE9 s\xF3 por dizer... Preciso ir com calma.\""
  - key: 7
    thought: "\"Se eu pudesse viajar no tempo, como naquele filme do cientista idoso
      com um carro, talvez essa seria a resposta certa... Mas n\xE3o \xE9 o caso,
      preciso identificar o momento exato em que tudo estava intacto.\""
  - key: 8
    thought: "\"Como minha v\xF3zinha sempre dizia... \"O apressado como cru.\" Ainda
      n\xE3o \xE9 o momento pra isso.\""
  - key: 12
    thought: "\"N\xE3o \xE9 hora de pesquisar isso aqui.\""
