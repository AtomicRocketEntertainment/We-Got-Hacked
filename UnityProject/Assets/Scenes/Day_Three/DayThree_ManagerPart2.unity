  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Nosso trabalho est\xE1 longe de acabar. Tenho certeza de que novos alertas
    j\xE1 est\xE3o sendo gerados neste momento. Ainda assim, reconhe\xE7o que ser
    constantemente met\xF3dica e pessimista pode ser exaustivo. Preciso admitir que
    o resultado de hoje \xE9 realmente, como diriam por a\xED, foda! N\xE3o h\xE1
    outro termo que transmita isso. Dedico esta vit\xF3ria ao babaca do meu irm\xE3o,
    que agora vai ter de reconhecer minha superioridade. Engole essa, Jorge!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9cc0f8926192f054497c9086591a2141, type: 2}
