  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "E mais uma aventura termina recheada de gl\xF3ria! O her\xF3i que antes
    era reprimido por brandir sua espada na escola, chamado de \u201Cesquisito\u201D
    ou at\xE9 de \u201Cmuleque que cheira a cebola\u201D, ser\xE1 lembrado agora
    por seus magn\xEDficos feitos! Os magos encapuzados dos c\xF3digos malignos foram
    brutalmente derrotados pela Guilda da Cafe\xEDna! E aquele curandeiro de tempos
    atr\xE1s estava errado... Voc\xEA n\xE3o precisa de ajuda psicol\xF3gica, s\xF3
    precisa empunhar sua espada e se preparar para os desafios que v\xEAm a\xED.
    Avante, Rafael!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9cc0f8926192f054497c9086591a2141, type: 2}
  m_sharedMaterial: {fileID: 5896909752060814302, guid: 9cc0f8926192f054497c9086591a2141,
