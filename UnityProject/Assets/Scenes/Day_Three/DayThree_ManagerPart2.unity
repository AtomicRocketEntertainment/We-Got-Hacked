  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Nem sempre o esfor\xE7o \xE9 recompensado no sistema em que nossos analistas
    vivem, e a meritocracia raramente funciona. Mas, de vez em quando, at\xE9 os
    coachs da internet acertam. Nesse dia, a PetroCais registrou sua maior alta na
    bolsa em todo o ano, surpreendendo at\xE9 os economistas mais pessimistas. Infelizmente,
    esse lucro n\xE3o chegar\xE1 nem perto de nossos funcion\xE1rios favoritos, mas
    ainda assim, eles se contentam com um pouco de credibilidade. A pr\xF3pria CEO
    da C.A.F.E., J\xE9ssica Ferreira, enviou uma mensagem parabenizando a equipe
    pela incr\xEDvel conquista. Dizendo que, assim como um delicioso caf\xE9 rec\xE9m-passado,
    eles teriam um futuro brilhante na \xE1rea de ciberseguran\xE7a! Ela n\xE3o era
    t\xE3o boa com analogias."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9cc0f8926192f054497c9086591a2141, type: 2}
  m_sharedMaterial: {fileID: 5896909752060814302, guid: 9cc0f8926192f054497c9086591a2141,
    type: 2}
