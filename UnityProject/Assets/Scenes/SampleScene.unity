--- !u!114 &1902760171
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1902760170}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Tiago,\n\nBem-vindo ao SOC da S.A.F.E (Security and Assurance for Enterprises).
    Nosso trabalho exige agilidade e precis\xE3o, ent\xE3o vou direto ao ponto.\n\nMeu
    nome \xE9 Raquel Oliveira, sou a gerente de Cyberseguran\xE7a e respons\xE1vel
    por coordenar a equipe que atuar\xE1 na prote\xE7\xE3o da PetroCorp. Vou liderar
    esse novo time, e voc\xEA, junto com os demais analistas, ter\xE1 um papel fundamental
    na defesa contra amea\xE7as cibern\xE9ticas.\n\nAqui est\xE1 sua chave de acesso
    ao AlarmGroove, nossa plataforma de monitoramento e resposta a incidentes:\n\nAG-91X5-K7P3-LD82\n\nEssa
    chave \xE9 individual e sigilosa. N\xE3o compartilhe.\n\nNossa miss\xE3o \xE9
    garantir a seguran\xE7a das opera\xE7\xF5es da PetroCorp, lidando com tentativas
    de invas\xE3o e riscos constantes. Seu papel \xE9 identificar e filtrar os alertas,
    garantindo que apenas os verdadeiros positivos sejam encaminhados ao N2 para
    resolu\xE7\xE3o.\n\nNosso trabalho exige aten\xE7\xE3o e responsabilidade. Se
    precisar de algo, me comunique diretamente.\n\nRaquel Oliveira\nGerente de Cyberseguran\xE7a
    \u2013 S.A.F.E"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
