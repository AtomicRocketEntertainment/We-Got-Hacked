      m_Calls: []
  m_text: "Mais uma tarefa \xE9 conclu\xEDda e adicionada \xE0 lista de conquistas
    do analista pleno. Enquanto isso, nossa querida gerente enfrenta uma situa\xE7\xE3o
    delicada, tentando conter as desaven\xE7as ideol\xF3gicas entre os convidados
    da Sala de Guerra. Talvez, neste momento, ela finalmente entenda por que o nome
    \xE9 t\xE3o apropriado."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9cc0f8926192f054497c9086591a2141, type: 2}
