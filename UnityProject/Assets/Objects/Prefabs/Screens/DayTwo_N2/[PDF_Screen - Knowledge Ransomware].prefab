    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 607800744420793112, guid: 121591b869bf2b04abf4f32e4571ed45,
        type: 3}
      propertyPath: m_text
      value: "WannaCry: \xE9 um ransomware que criptografa arquivos e exige resgate,
        not\xE1vel por sua funcionalidade que permite se espalhar automaticamente.
        As infec\xE7\xF5es ocorrem principalmente atrav\xE9s da explora\xE7\xE3o
        da vulnerabilidade EternalBlue em computadores que utilizam o sistema operacional
        Windows desatualizado, que permite ao ransomware se espalhar por redes conectadas
        usando a porta 445/TCP.\n\_\nVulnerabilidade de ataque a Acesso Remoto inseguro\LExplora\xE7\xE3o
        da falha no protocolo que gerencia portas do Windows, permitindo a execu\xE7\xE3o
        remota de c\xF3digo externo. Para corrigir esta vulnerabilidade, deve ser
        aplicado o patch\nFileServer-2021-00106.\n\_"
      objectReference: {fileID: 0}
    - target: {fileID: 650204337312150029, guid: 121591b869bf2b04abf4f32e4571ed45,
