      m_Calls: []
  m_text: "A PetroCais est\xE1 firmando parcerias estrat\xE9gicas com redes aliment\xEDcias
    para desenvolver uma <b>linha de alimentos</b> com um leve toque de petr\xF3leo.
    Os produtos ainda n\xE3o lan\xE7aram oficialmente, mas alguns especialistas j\xE1
    afirmam que o <b>sabor \xE9 divino</b>!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
