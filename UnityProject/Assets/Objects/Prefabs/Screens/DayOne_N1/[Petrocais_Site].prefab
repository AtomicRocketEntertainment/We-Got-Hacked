  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Na PetroCais, nossa rede de parceiros \xE9 fundamental para impulsionar
    nosso crescimento e garantir opera\xE7\xF5es seguras e eficientes.\r\n\r\n<b>Financeiro</b>\LEntre
    nossos aliados, temos a <b>Dark Gold Stock Exchange (DGSE)</b>, que nos fornece
    suporte financeiro e permite otimizar nossos recursos e expandir nossas opera\xE7\xF5es.\r\n\r\n<b>Ciberseguran\xE7a</b>\LPara
    garantir a prote\xE7\xE3o de nossas informa\xE7\xF5es e sistemas, contamos com
    a colabora\xE7\xE3o da <b>C.A.F.E.</b>. Juntos, trabalhamos para fortalecer nossas
    defesas contra amea\xE7as digitais e assegurar a confidencialidade de nossos
    dados."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
