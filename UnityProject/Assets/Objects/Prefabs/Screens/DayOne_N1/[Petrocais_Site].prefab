      m_Calls: []
  m_text: "<b>PetroCais Lan\xE7a Programa Global de Reciclagem de Pl\xE1sticos</b>\r\nEm
    linha com seu compromisso com a sustentabilidade, a PetroCais lan\xE7ou o programa
    <b>Desplastificando</b>, que visa conscientizar consumidores sobre o descarte
    respons\xE1vel de pl\xE1sticos."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
