  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Nossa miss\xE3o \xE9 expor os verdadeiros culpados pelo nosso planeta
    estar morrendo... As malditas ind\xFAstrias de petr\xF3leo. Somos brasileiros,
    filhos da terra que est\xE1 sendo queimada viva, e estamos cansados de assistir
    \xE0 destrui\xE7\xE3o da nossa casa em sil\xEAncio.\n\nA m\xEDdia adora culpar
    voc\xEA! Como se um canudo de papel fosse resolver o problema. As tartarugas
    continuam morrendo! N\xE3o seja uma ferramenta desse jogo doentio deles.\_"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9cc0f8926192f054497c9086591a2141, type: 2}
