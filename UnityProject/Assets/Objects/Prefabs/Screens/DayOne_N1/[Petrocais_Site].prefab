  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A <b>PetroCais</b> tem investido de maneira significativa em inova\xE7\xE3o
    e tecnologia para solidificar sua posi\xE7\xE3o no setor energ\xE9tico. Ampliando
    sua presen\xE7a em \xE1reas maiores, <b>construindo ind\xFAstrias</b> em grandes
    regi\xF5es para atender \xE0 crescente demanda de seus produtos.\r\n\r\nA petrol\xEDfera
    investe em <b>pesquisa e desenvolvimento</b>, contando com uma equipe de cientistas
    dedicados a desenvolver produtos altamente eficientes, como <b>gasolina de alta
    octanagem</b> e <b>\xF3leo diesel com maior teor de enxofre</b>.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
