      m_Calls: []
  m_text: "Voc\xEA Sabia? O nome <b>PetroCais</b> surgiu quando o jovem fundador
    estava pilotando um barco em um porto movimentado e quase bateu. Um de seus amigos
    gritou: <b>\"Pedro, o cais!\"</b>\nEle desviou a tempo, mas ficou pensativo.
    Olhou para seu colega e pediu: <b>\"Diga isso de novo\u2026\"</b>. E assim nascia
    o nome de uma das maiores empresas petrol\xEDferas do Brasil!\n<sprite index=\"32\"><sprite
    index=\"202\">"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9cc0f8926192f054497c9086591a2141, type: 2}
