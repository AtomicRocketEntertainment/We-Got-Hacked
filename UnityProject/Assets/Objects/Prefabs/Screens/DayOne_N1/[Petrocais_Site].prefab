      m_Calls: []
  m_text: "Os consumidores precisam entender que o problema do excesso de lixo n\xE3o
    existe porque grandes empresas descartam toneladas de porcarias em qualquer lugar.
    A verdadeira culpa \xE9 sua. Sim, voc\xEA mesmo, usando sacolinhas pl\xE1sticas
    como se n\xE3o houvesse amanh\xE3! N\xE3o podemos parar de produzir quantidades
    absurdas de pl\xE1stico descart\xE1vel, afinal, os idiotas ainda precisam continuar
    comprando. E nem precisamos pedir pra consumirem mais! Os micropl\xE1sticos no
    seu c\xE9rebro j\xE1 fazem isso por n\xF3s!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9cc0f8926192f054497c9086591a2141, type: 2}
