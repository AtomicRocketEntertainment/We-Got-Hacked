  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>N\xD3S SOMOS OS PETROKILLERS</b>\r\n\r\nNossa miss\xE3o \xE9 expor
    essas petrol\xEDferas que matam nosso planeta!\nEnquanto esses porcos capitalistas
    enchem os bolsos, a nossa Amaz\xF4nia queima, os mares s\xE3o envenenados e <b>MILH\xD5ES
    DE ANIMAIS E PLANTAS MORREM TODOS OS DIAS!</b>. \r\n\r\n<b>CHEGA!</b>\r\n\n <b>DESTRUA
    OS BARRIS E SALVE O FUTURO!</b>\r\n\r\n#DestroyTheBarrels\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
