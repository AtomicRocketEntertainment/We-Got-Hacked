  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Voc\xEAs nunca entender\xE3o o quanto n\xF3s sofremos\u2026 snif snif.
    Ver nossa fam\xEDlia inteira chorando querendo ter um avi\xE3o, nossos cachorros
    babando ao sonhar com sua pr\xF3pria ilha particular no oceano \xCDndico\u2026
    Tudo o que queremos \xE9 ter mais dinheiro do que 50% da popula\xE7\xE3o mundial
    junta. Isso \xE9 pedir muito? N\xF3s nos dedicamos pra chegar at\xE9 aqui, foi
    muito esfor\xE7o explorando o m\xE1ximo dos funcion\xE1rios e comprando outras
    petrol\xEDferas ilegalmente pra gerar esse monop\xF3lio. Nos ajude a conquistar
    isso! \L\L<b>N\xF3s somos o combust\xEDvel da desgra\xE7a!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9cc0f8926192f054497c9086591a2141, type: 2}
