  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A <b>PetroCais Ltda.</b> foi fundada em <b>20 de maio de 1982</b> por
    <b>Pedro Kaiser</b>, um vision\xE1rio de origem alem\xE3 e patriota convicto,
    com a ambi\xE7\xE3o de <b>comercializar petr\xF3leo</b> e seus derivados no Brasil.\n\nA
    cria\xE7\xE3o da empresa foi impulsionada pela determina\xE7\xE3o de Kaiser em
    <b>fortalecer a ind\xFAstria energ\xE9tica nacional</b> e garantir que o pa\xEDs
    se tornasse <b>autossuficiente</b> em rela\xE7\xE3o \xE0s suas necessidades energ\xE9ticas.\n\nFoi
    atrav\xE9s do fundador que surgiu o famoso slogan da empresa: <b>\"Somos o combust\xEDvel
    do progresso\"</b>, enfatizando sua cren\xE7a de que o <b>crescimento econ\xF4mico</b>
    deveria sempre estar em primeiro lugar.\n\nDesde o in\xEDcio, a <b>PetroCais</b>
    investiu fortemente em <b>tecnologia</b> e <b>infraestrutura</b>, priorizando
    a <b>explora\xE7\xE3o intensiva</b> das reservas de petr\xF3leo, uma estrat\xE9gia
    que se tornou a <b>marca registrada</b> da empresa.\n\nHoje, a <b>PetroCais</b>
    se orgulha de ser uma <b>gigante energ\xE9tica global</b>, impulsionando o <b>crescimento
    industrial</b> e fornecendo a <b>energia</b> que move o mundo."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9cc0f8926192f054497c9086591a2141, type: 2}
  m_sharedMaterial: {fileID: 5896909752060814302, guid: 9cc0f8926192f054497c9086591a2141,
