  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Log\xEDstica e Transporte</b>\LContamos com a parceria da <b>Transporteira
    SP</b>, especializada em transporte de cargas perigosas e insumos energ\xE9ticos
    dentro do pa\xEDs, assegurando entregas \xE1geis e seguras para nossas refinarias
    e terminais.\r\n\r\n<b>Rela\xE7\xF5es Institucionais e Comunica\xE7\xE3o</b>\LPara
    manter uma presen\xE7a s\xF3lida tanto no mercado quanto nos bastidores pol\xEDticos,
    a <b>PubliCorrupt Consultorias</b> atua como nossa parceira estrat\xE9gica, combinando
    expertise em rela\xE7\xF5es governamentais, consultoria normativa e gerenciamento
    de imagem p\xFAblica."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
