    - target: {fileID: 5419090090762928253, guid: ec5e4f2efccacbb42aac7e4e17223394,
        type: 3}
      propertyPath: m_text
      value: "Vulnerabilidade de Ataque de For\xE7a Bruta em Acesso Remoto: Explora\xE7\xE3o
        de configura\xE7\xF5es fracas do protocolo de \xC1rea de Trabalho Remota
        (RDP), permitindo que atacantes tentem repetidamente combina\xE7\xF5es de
        senhas para invas\xE3o, possibilitando a execu\xE7\xE3o de aplica\xE7\xF5es
        maliciosas. Para corre\xE7\xE3o, aplicar o patch RemoteAccess-2025-0125."
      objectReference: {fileID: 0}
