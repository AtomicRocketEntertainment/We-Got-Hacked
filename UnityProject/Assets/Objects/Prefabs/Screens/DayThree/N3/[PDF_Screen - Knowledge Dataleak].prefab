    - target: {fileID: 1126391718343125712, guid: ec5e4f2efccacbb42aac7e4e17223394,
        type: 3}
      propertyPath: m_text
      value: "Vulnerabilidade de Trojan de Acesso Remoto (RAT): Vulnerabilidade que
        explora falhas em softwares de terceiros, permitindo a utiliza\xE7\xE3o de
        scripts PowerShell para baixar e executar aplica\xE7\xF5es maliciosas que
        estabelecem uma persistente comunica\xE7\xE3o de Acesso Remoto (RAT). Para
        corrigir esta vulnerabilidade, aplicar o patch RAT-2025-0123."
      objectReference: {fileID: 0}
