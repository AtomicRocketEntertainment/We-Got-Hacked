  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>N\xD3S SOMOS OS PETROKILLERS</b>\r\n\r\n<b>O que aconteceu?</b>\LSurpresa!
    Seus arquivos foram criptografados. Todos aqueles relat\xF3rios sem gra\xE7a,
    planilhas numeradas e documentos que fariam ser CEO ser preso? Bloqueados. Trancados
    a sete chaves.\r\n\r\n<b>Como recupero meus arquivos?</b>\LSomos hackers, n\xE3o
    monstros! Voc\xEA pode recuperar tudo por apenas 100 milh\xF5es de d\xF3lares!
    Que pechincha... Depois de pagar, liberaremos seu acesso. Simples assim!\r\n\r\n<b>\xC9
    um prazer fazer neg\xF3cios com voc\xEA!</b>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9cc0f8926192f054497c9086591a2141, type: 2}
